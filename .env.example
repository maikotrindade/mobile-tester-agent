# Copy to `.env` and fill in. Loaded automatically by dotenv-kotlin (backend)
# and by Vite (the VITE_* keys, for the web/ dashboard).
# `.env` is gitignored — never commit real keys.

# --- LLM provider keys (at least one is required) -----------------------------

# DeepSeek — https://platform.deepseek.com/usage
# Default executor (see agent/model/MobileTesterConfig.kt).
DEEP_SEEK_KEY=

# Anthropic Claude — https://console.anthropic.com/usage
CLAUDE_API_KEY=

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter — https://openrouter.ai/keys
OPEN_ROUTER=

# Ollama executors (ollama_llama, ollama_gwen) talk to a local Ollama daemon
# and need no API key.

# --- Artifact output ----------------------------------------------------------

# Absolute path where screenshots and screen recordings are pulled to.
# Must exist and be writable. See agent/tool/mobile/test/utils/MediaUtils.kt.
HOME_PATH=/path/to/your/mobile-tester-artifacts

# --- Web dashboard (web/) -----------------------------------------------------
# These are also picked up if you put them in web/.env.local instead.
# Vite exposes any VITE_* var to the browser bundle.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
